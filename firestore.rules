rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own dataset metadata
    match /datasets/{docId} {
      allow read, write: if request.auth != null && resource == null || request.auth.uid == resource.data.user_uid;
      allow create: if request.auth != null;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
